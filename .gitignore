# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# office lock files
~$*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local PDF research and Python bytecode
/tmp/pdfs/
__pycache__/

# playwright mcp debug output
.playwright-mcp/

# playwright test artifacts
/test-results/
/playwright-report/

# generated outputs
/outputs/
/tmp/

# Ciasteczko obejscia ochrony Vercel dla e2e na stagingu
/e2e/.auth/

# Materialy MirageVision (89 MB, poufne cenniki resellerskie), nie do repozytorium
/_docs/mirageVision/

# Materialy zrodlowe do importow i wygenerowane widoki, nie do repozytorium
/_docs/logbar/
/_docs/comox/
/_docs/CocoLeisure_*.pdf
/output/architectural-views/

# Jednorazowe skrypty czyszczace prod
/drizzle/_wipe_project_requests.sql
/scripts/wipe-project-requests.mjs

<script>
var runslide=true;
jQuery('.mobile_home_slide_2').click(function(){
	var id;
	id = jQuery('#video_slide').find('.video_on').attr('id');
	if (jQuery('#'+id).attr('data-type')=="href") {window.location.href = jQuery('#'+id).attr('data-link');}
	if (jQuery('#'+id).attr('data-type')=="movie") {
		jQuery('.preloader').html('<iframe width="100%" height="100%" src="https://www.youtube.com/embed/'+jQuery('#'+id).attr('data-link')+'" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe><div class="close_player"><span id="fixed_hamburger2" style="display: table; cursor: pointer; float: left; height: 114px;"><span style="vertical-align: middle; display: table-cell; text-align: center;"><div class="hamburger hamburger--collapse is-active"><div class="hamburger-box"><div class="hamburger-inner"></div></div></div></span></span><img src="/wp-content/themes/budman/images/logo.png" class="logo_image"></div>');
		jQuery('.preloader').fadeIn();
		jQuery('.close_player').click(function() {jQuery('.preloader').fadeOut().html('');});
	}
});

jQuery('.video_slide').click(function(){
	runslide = false;
	if (!jQuery(this).hasClass('video_on')) {
		jQuery('#video_slide').find('.video_on').removeClass('video_on').addClass('video_off');
		jQuery(this).addClass('video_on').removeClass('video_off');
		jQuery('.mobile_home_slide_2').css('background-image',"url('"+jQuery(this).attr('data-image')+"')");
		jQuery('#slide_title').html(jQuery(this).attr('data-title'));
		jQuery('#slide_text').html(jQuery(this).attr('data-text'));
	}
	
});

setInterval(function() {
	if (runslide) {
	current = jQuery('#video_slide').find('.video_on'); 
	if (current.next().length==1) {
		current.next().removeClass('video_off').addClass('video_on');
		current.removeClass('video_on').addClass('video_off');
		jQuery('.mobile_home_slide_2').css('background-image',"url('"+current.next().attr('data-image')+"')");
		jQuery('#slide_title').html(current.next().attr('data-title'));
		jQuery('#slide_text').html(current.next().attr('data-text'));
	}
	else {
		jQuery('#video_slide').find('.video_off').first().addClass('video_on').removeClass('video_off');
		current.removeClass('video_on').addClass('video_off');
		jQuery('.mobile_home_slide_2').css('background-image',"url('"+jQuery('#video_slide').find('.video_on').first().attr('data-image')+"')");
		jQuery('#slide_title').html(jQuery('#video_slide').find('.video_on').first().attr('data-title'));
		jQuery('#slide_text').html(jQuery('#video_slide').find('.video_on').first().attr('data-text'));
	}
	}
	}, 5000);
</script>

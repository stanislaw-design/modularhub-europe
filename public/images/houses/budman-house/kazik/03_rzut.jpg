<div class="section fp-auto-height-responsive" data-anchor="faq">
<div class="container-fluid remove-all-margin-padding faq_container">
<div class="row remove-all-margin-padding"><div class="col-12"><h1 class="light"><img src="/wp-content/themes/budman/icons/kreska_poziom.svg" style="width: 117px; margin-right: 33px; margin-bottom: 7px;">Najczęściej<br>zadawane pytania</h1></div></div>

<div id="scroll-left_faq" class="scrollbox-controlArrow scrollbox-prev scrollbox-"></div>
<div id="scroll-right_faq" class="scrollbox-controlArrow scrollbox-next scrollbox-"></div>
<script>
jQuery('#scroll-right_faq').click(function(){
var skok=jQuery('#scrollbox_faq').first('.postintro-col').width();  jQuery('#scrollbox_faq').animate({ scrollLeft: '+='+skok }, 500);
});

<script>
jQuery(document).ready(function() {
	var animslide=false;
	new fullpage('#fullpage', {
		responsiveSlides: true,
		responsiveWidth: 769,
		css3: true,
		recordHistory: false,
		autoScrolling: true,
		normalScrollElements: '.paoc-popup-modal',
		scrollHorizontally: true,
		controlArrows: true,
		verticalCentered: true,
		scrollOverflow: true,
		scrollBar: false,
		slidesNavigation: false,
		navigation: false,
		afterRender: function() {
			runAnimations();
		},
		onLeave: function(index, direction) {
			if (fullpage_api.getActiveSection().anchor=="technologia_3") {
				document.getElementById('lp_a1').getLottie().stop();
				document.getElementById('lp_a2').getLottie().stop();
				document.getElementById('lp_a3').getLottie().stop();
			}
		},
		afterLoad: function(origin, destination, direction){
			jQueryAnim();
			
				if (fullpage_api.getActiveSection().anchor=="technologia-disabled") {
				document.getElementById('scianaRot').getLottie().loop = false;
				setTimeout(function(){ document.getElementById('scianaRot').getLottie().play(); }, 1000);
			}
			
	        if (!(jQuery('#fixed_header').hasClass('hide-header'))) { 
	            jQuery('#fixed_header').addClass('hide-header');}

	        if (fullpage_api.getActiveSection().anchor=="projekt") {
	        	jQuery('.arrow_down_txt').css("display","block");
	        }
	        else jQuery('.arrow_down_txt').fadeOut('1000');
			if ((fullpage_api.getActiveSection().anchor=="start") ||
					(fullpage_api.getActiveSection().anchor=="technologia") ||
					(fullpage_api.getActiveSection().anchor=="technologia_2") ||
					(fullpage_api.getActiveSection().anchor=="projekt")) 
				{ jQuery('.arrow_down').fadeIn('1000','linear',function() {jQuery('.arrow_down').css("transition-duration","0.5s");}); }
			else { jQuery('.arrow_down').css("transition-duration","initial");  jQuery('.arrow_down').fadeOut('1000'); }

			if (fullpage_api.getActiveSection().isFirst) {jQuery('#fixed_header').removeClass('hide-header');}
			if (fullpage_api.getActiveSection().anchor=="technologia_3") {
				document.getElementById('lp_a1').getLottie().stop();
				document.getElementById('lp_a2').getLottie().stop();
				document.getElementById('lp_a3').getLottie().stop();
				document.getElementById('lp_a1').getLottie().loop = 'true';
				document.getElementById('lp_a2').getLottie().loop = 'true';
				document.getElementById('lp_a3').getLottie().loop = 'true';
				document.getElementById('lp_a1').getLottie().play();
				setTimeout(function(){ document.getElementById('lp_a2').getLottie().play(); }, 2000);
				setTimeout(function(){ document.getElementById('lp_a3').getLottie().play(); }, 4000);
			}
		}
	});

	document.querySelector('.arrow_down').addEventListener('click', function(e){
		e.preventDefault();
		fullpage_api.moveSectionDown();
		
	});

});

function jQueryAnimDisabled() {
	var currentactive = jQuery('#fullpage .active');
	var currentactivenotslide = jQuery('#fullpage > .active > :not(.slide)');
	jQuery('#fullpage .active .jq_fadein_bottom').animate({bottom: '+=30', opacity: 1 }, 1000, function() { 
		jQuery('#fullpage .active').find('.jq_fadein_bottom').removeClass('jq_fadein_bottom'); 
		} );
	jQuery('#fullpage .active .jq_fadein_bottom_500').delay(500).animate({bottom: '+=30', opacity: 1 }, 1000, function() { 
		jQuery('#fullpage .active').find('.jq_fadein_bottom_500').removeClass('jq_fadein_bottom_500'); 
		} );

	jQuery('#fullpage .active .jq_fadein').animate({opacity: 1 }, 1000, function() { jQuery('#fullpage .active').find('.jq_fadein').removeClass('jq_fadein'); } );
	jQuery('#fullpage .active .jq_fadein_right').animate({right: '+=30', opacity: 1 }, 1000, function() { jQuery('#fullpage .active').find('.jq_fadein_right').removeClass('jq_fadein_right'); } );
	jQuery('#fullpage > .active > :not(.slide) > .jq_fadein_bottom').animate({bottom: '+=30', opacity: 1 }, 1000, function() { currentactivenotslide.find('.jq_fadein_bottom').removeClass('jq_fadein_bottom'); } );
	jQuery('#fullpage > .active > :not(.slide) > .jq_fadein_bottom_500').delay(500).animate({bottom: '+=30', opacity: 1 }, 1000, function() { currentactivenotslide.find('.jq_fadein_bottom_500').removeClass('jq_fadein_bottom_500'); } );
	jQuery('#fullpage .active .jq_fadein_bottom_1000').delay(1000).animate({bottom: '+=30', opacity: 1 }, 1000, function() { currentactive.find('.jq_fadein_bottom_1000').removeClass('jq_fadein_bottom_1000'); } );
	jQuery('#fullpage .active .jq_fadein_left').animate({left: '+=30', opacity: 1 }, 1000, function() { currentactive.find('.jq_fadein_left').removeClass('jq_fadein_left'); } );
	jQuery('#fullpage .active .jq_fadein_left_500').delay(500).animate({left: '+=30', opacity: 1 }, 1000, function() { currentactive.find('.jq_fadein_left_500').removeClass('jq_fadein_left_500'); } );
	jQuery('#fullpage .active .jq_fadein_left_1000').delay(1000).animate({left: '+=30', opacity: 1 }, 1000, function() { currentactive.find('.jq_fadein_left_1000').removeClass('jq_fadein_left_1000'); } );

}

function jQueryAnimJustShowUp() {
	var currentactive = jQuery('#fullpage .active');
	var currentactivenotslide = jQuery('#fullpage > .active > :not(.slide)');
	jQuery('#fullpage .active .jq_fadein_bottom').animate({bottom: '+=30', opacity: 1 }, 0, function() { 
		jQuery('#fullpage .active').find('.jq_fadein_bottom').removeClass('jq_fadein_bottom'); 
		} );
	jQuery('#fullpage .active .jq_fadein_bottom_500').delay(0).animate({bottom: '+=30', opacity: 1 }, 0, function() { 
		jQuery('#fullpage .active').find('.jq_fadein_bottom_500').removeClass('jq_fadein_bottom_500'); 
		} );

	jQuery('#fullpage .active .jq_fadein').animate({opacity: 1 }, 0, function() { jQuery('#fullpage .active').find('.jq_fadein').removeClass('jq_fadein'); } );
	jQuery('#fullpage .active .jq_fadein_right').animate({right: '+=30', opacity: 1 }, 0, function() { jQuery('#fullpage .active').find('.jq_fadein_right').removeClass('jq_fadein_right'); } );
	jQuery('#fullpage > .active > :not(.slide) > .jq_fadein_bottom').animate({bottom: '+=30', opacity: 1 }, 0, function() { currentactivenotslide.find('.jq_fadein_bottom').removeClass('jq_fadein_bottom'); } );
	jQuery('#fullpage > .active > :not(.slide) > .jq_fadein_bottom_500').delay(0).animate({bottom: '+=30', opacity: 1 }, 0, function() { currentactivenotslide.find('.jq_fadein_bottom_500').removeClass('jq_fadein_bottom_500'); } );
	jQuery('#fullpage .active .jq_fadein_bottom_1000').delay(0).animate({bottom: '+=30', opacity: 1 }, 0, function() { currentactive.find('.jq_fadein_bottom_1000').removeClass('jq_fadein_bottom_1000'); } );
	jQuery('#fullpage .active .jq_fadein_left').animate({left: '+=30', opacity: 1 }, 0, function() { currentactive.find('.jq_fadein_left').removeClass('jq_fadein_left'); } );
	jQuery('#fullpage .active .jq_fadein_left_500').delay(0).animate({left: '+=30', opacity: 1 }, 0, function() { currentactive.find('.jq_fadein_left_500').removeClass('jq_fadein_left_500'); } );
	jQuery('#fullpage .active .jq_fadein_left_1000').delay(0).animate({left: '+=30', opacity: 1 }, 0, function() { currentactive.find('.jq_fadein_left_1000').removeClass('jq_fadein_left_1000'); } );
}

function jQueryAnim() {
	var currentactive = jQuery('#fullpage');
	var currentactivenotslide = jQuery('#fullpage > .active > :not(.slide)');
	jQuery('#fullpage .jq_fadein_bottom').animate({bottom: '+=30', opacity: 1 }, 0, function() { 
		jQuery('#fullpage').find('.jq_fadein_bottom').removeClass('jq_fadein_bottom'); 
		} );
	jQuery('#fullpage .jq_fadein_bottom_500').delay(0).animate({bottom: '+=30', opacity: 1 }, 0, function() { 
		jQuery('#fullpage').find('.jq_fadein_bottom_500').removeClass('jq_fadein_bottom_500'); 
		} );

	jQuery('#fullpage .jq_fadein').animate({opacity: 1 }, 0, function() { jQuery('#fullpage').find('.jq_fadein').removeClass('jq_fadein'); } );
	jQuery('#fullpage .jq_fadein_right').animate({right: '+=30', opacity: 1 }, 0, function() { jQuery('#fullpage').find('.jq_fadein_right').removeClass('jq_fadein_right'); } );
	jQuery('#fullpage > .active > :not(.slide) > .jq_fadein_bottom').animate({bottom: '+=30', opacity: 1 }, 0, function() { currentactivenotslide.find('.jq_fadein_bottom').removeClass('jq_fadein_bottom'); } );
	jQuery('#fullpage > .active > :not(.slide) > .jq_fadein_bottom_500').delay(0).animate({bottom: '+=30', opacity: 1 }, 0, function() { currentactivenotslide.find('.jq_fadein_bottom_500').removeClass('jq_fadein_bottom_500'); } );
	jQuery('#fullpage .jq_fadein_bottom_1000').delay(0).animate({bottom: '+=30', opacity: 1 }, 0, function() { currentactive.find('.jq_fadein_bottom_1000').removeClass('jq_fadein_bottom_1000'); } );
	jQuery('#fullpage .jq_fadein_left').animate({left: '+=30', opacity: 1 }, 0, function() { currentactive.find('.jq_fadein_left').removeClass('jq_fadein_left'); } );
	jQuery('#fullpage .jq_fadein_left_500').delay(0).animate({left: '+=30', opacity: 1 }, 0, function() { currentactive.find('.jq_fadein_left_500').removeClass('jq_fadein_left_500'); } );
	jQuery('#fullpage .jq_fadein_left_1000').delay(0).animate({left: '+=30', opacity: 1 }, 0, function() { currentactive.find('.jq_fadein_left_1000').removeClass('jq_fadein_left_1000'); } );
}
function runAnimations() {
	ScrollReveal().reveal('.sr_fadein_left', { reset: false, delay: 1500, origin: 'left', distance: '10px', easing: 'ease-in-out', opacity: 0,});
};
jQuery('window').resize(function() {
	fullpage_api.reBuild();
});

	
</script>

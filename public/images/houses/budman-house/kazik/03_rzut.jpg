<script language="JavaScript">

jQuery('span.accept').on('click', function() {
	document.cookie = "cookie=accept";
	jQuery('#cookie').css('display','none'); 
});

jQuery('.menu-item').on('click', function() {
	showhideMenu();
});
function showhideMenu() {
	  if (jQuery(window).width()<768) {
		  var $hamburger = jQuery(".hamburger");
	      jQuery( "#header_menu" ).slideToggle( "slow", function() {});
		  $hamburger.toggleClass("is-active");
		  jQuery('#fixed_header').toggleClass('full-height');
		  }
		  if ((jQuery(window).width()>=768) && (jQuery(window).width()<1200)) {
			  var $hamburger = jQuery(".hamburger");
		      jQuery( "#header_menu" ).toggleClass('show-menu');
			  $hamburger.toggleClass("is-active");
			  //jQuery('#fixed_header').toggleClass('full-height');
			  }    
		jQuery('#fixed_header').removeClass('hide-header');
	
}
jQuery('#fixed_hamburger').click(function(){ showhideMenu();});
jQuery('#fixed_hamburger2').click(function(){ showhideMenu();});

jQuery('#click2hidemenu').click(function(){
	if (!(jQuery('#fixed_header').hasClass('hide-header')))
		jQuery('#fixed_header').addClass('hide-header');
});
//Hide Header on on scroll down

var didScroll;
var lastScrollTop = 0;
var delta = 5;
var navbarHeight = jQuery('#fixed_header').outerHeight();

jQuery(window).scroll(function(event){
    didScroll = true;
});


setInterval(function() {
    if (didScroll) {
        hasScrolled();
        didScroll = false;
    }
}, 250);

function hasScrolled() {
    var st = jQuery(this).scrollTop();
    if(Math.abs(lastScrollTop - st) <= delta)
        return;
    if (st > lastScrollTop && st > navbarHeight){
        // Scroll Down
        if (!(jQuery('#fixed_header').hasClass('hide-header'))) { 
        jQuery('#fixed_header').addClass('hide-header');}
    } else {
        // Scroll Up
        if(st + jQuery(window).height() < jQuery(document).height()) {
        	if (!(jQuery('#fixed_header').hasClass('hide-header'))) {
        	jQuery('#fixed_header').addClass('hide-header');
        	}
        }
    }
    
    lastScrollTop = st;
}
</script>

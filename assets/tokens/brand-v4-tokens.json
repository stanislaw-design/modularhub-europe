{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brandV4": {
    "color": {
      "$description": "Marketing aliases for the current global black, navy, orange, alabaster and white identity.",
      "night": { "$value": "#000000", "$type": "color" },
      "nightDeep": { "$value": "#14213D", "$type": "color" },
      "paper": { "$value": "#E5E5E5", "$type": "color" },
      "surface": { "$value": "#FFFFFF", "$type": "color" },
      "amber": {
        "$value": "#FCA311",
        "$type": "color",
        "$description": "Allowed action color in v4 (CTAs, rating stars), unlike v3's Interior Light."
      },
      "amberStrong": { "$value": "#E89200", "$type": "color" },
      "amberForeground": {
        "$value": "#000000",
        "$type": "color",
        "$description": "Only allowed text/icon color on an orange fill; white on orange does not meet AA for normal text."
      },
      "ink": { "$value": "#000000", "$type": "color" },
      "muted": { "$value": "#4D5562", "$type": "color" },
      "mist": { "$value": "#E5E5E5", "$type": "color" },
      "line": { "$value": "#E5E5E5", "$type": "color" },
      "lineDark": { "$value": "rgba(255, 255, 255, 0.20)", "$type": "color" }
    },
    "radius": {
      "pill": { "$value": "999px", "$type": "dimension" },
      "panel": { "$value": "28px", "$type": "dimension" },
      "card": { "$value": "20px", "$type": "dimension" }
    }
  }
}

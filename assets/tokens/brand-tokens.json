{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "brand": "Modular cross-border platform",
    "workingName": "Modular Hub Europe",
    "version": "0.1",
    "status": "draft",
    "updated": "2026-08-04"
  },
  "color": {
    "brand": {
      "primary": { "$type": "color", "$value": "#175CD3" },
      "ink": { "$type": "color", "$value": "#10263D" },
      "graphite": { "$type": "color", "$value": "#263746" }
    },
    "neutral": {
      "paper": { "$type": "color", "$value": "#F4F1EA" },
      "surface": { "$type": "color", "$value": "#E9E5DC" },
      "line": { "$type": "color", "$value": "#C8C4BB" },
      "muted": { "$type": "color", "$value": "#566473" },
      "white": { "$type": "color", "$value": "#FFFFFF" }
    },
    "status": {
      "$description": "Reserved for labelled product compliance statuses. Never use as brand or marketing accents.",
      "confirmed": { "$type": "color", "$value": "#14804A" },
      "conditional": { "$type": "color", "$value": "#B76E00" },
      "notAdmissible": { "$type": "color", "$value": "#C43D3D" }
    }
  },
  "font": {
    "heading": { "$type": "fontFamily", "$value": ["IBM Plex Sans Condensed", "Arial Narrow", "sans-serif"] },
    "body": { "$type": "fontFamily", "$value": ["Inter", "Helvetica Neue", "Arial", "sans-serif"] },
    "data": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "Roboto Mono", "monospace"] }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "8": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "12": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
    "16": { "$type": "dimension", "$value": { "value": 64, "unit": "px" } },
    "24": { "$type": "dimension", "$value": { "value": 96, "unit": "px" } }
  },
  "radius": {
    "document": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
    "control": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
  }
}
